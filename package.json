{
  "name": "garden-manager",
  "private": true,
  "version": "0.3.6",
  "type": "module",
  "engines": {
    "node": ">=22.12.0"
  },
  "scripts": {
    "dev": "vite --host 0.0.0.0 --port 5173 --strictPort",
    "build": "tsc -b && vite build",
    "preview": "vite preview --host 0.0.0.0 --port 4173 --strictPort",
    "test": "vitest run",
    "test:e2e": "playwright test",
    "test:pwa": "npm run build && playwright test --config=playwright.pwa.config.ts",
    "build:android": "tsc -b && vite build --mode android",
    "android:sync": "npm run build:android && cap sync android",
    "android:apk": "npm run android:sync && cd android && ./gradlew assembleDebug",
    "android:open": "cap open android",
    "test:android-web": "npm run build:android && playwright test --config=playwright.android.config.ts",
    "desktop:compile": "tsc -p desktop/tsconfig.json",
    "build:windows": "tsc -b && vite build --mode windows && npm run desktop:compile",
    "desktop:dev": "npm run build:windows && electron .",
    "test:desktop:unit": "npm run desktop:compile && node desktop-tests/policy.test.cjs",
    "test:desktop": "playwright test --config=playwright.desktop.config.ts",
    "windows:installer": "npm run build:windows && electron-builder --win nsis --x64 --config desktop/electron-builder.cjs --publish never"
  },
  "dependencies": {
    "@capacitor/android": "8.6.0",
    "@capacitor/app": "8.1.2",
    "@capacitor/camera": "8.2.6",
    "@capacitor/core": "8.6.0",
    "@pdf-lib/fontkit": "^1.1.1",
    "fflate": "^0.8.3",
    "lucide-react": "^0.468.0",
    "pdf-lib": "^1.17.1",
    "react": "^19.2.0",
    "react-dom": "^19.2.0"
  },
  "devDependencies": {
    "@capacitor/cli": "8.6.0",
    "@playwright/test": "^1.56.1",
    "@tailwindcss/vite": "^4.1.17",
    "@types/node": "^24.10.0",
    "@types/react": "^19.2.2",
    "@types/react-dom": "^19.2.2",
    "@vitejs/plugin-react": "^5.1.0",
    "electron": "45.2.3",
    "electron-builder": "26.18.0",
    "fake-indexeddb": "^6.2.7",
    "pdfjs-dist": "^4.10.38",
    "tailwindcss": "^4.1.17",
    "typescript": "~5.9.3",
    "vite": "^7.2.2",
    "vite-plugin-pwa": "^1.1.0",
    "vitest": "^4.0.9"
  },
  "overrides": {
    "for-each": "0.3.5"
  },
  "main": "desktop/build/main.cjs"
}
