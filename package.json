    "test:e2e": "playwright test",
    "test:pwa": "npm run build && playwright test --config=playwright.pwa.config.ts"
  },
  "dependencies": {
    "react": "^19.2.0", "react-dom": "^19.2.0", "lucide-react": "^0.468.0"
  },
  "devDependencies": {
    "@playwright/test": "^1.56.1", "@tailwindcss/vite": "^4.1.17", "@types/node": "^24.10.0", "@types/react": "^19.2.2", "@types/react-dom": "^19.2.2", "@vitejs/plugin-react": "^5.1.0", "tailwindcss": "^4.1.17", "typescript": "~5.9.3", "vite": "^7.2.2", "vite-plugin-pwa": "^1.1.0", "vitest": "^4.0.9"
  }
}
